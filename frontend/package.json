{
  "name": "self-healing-load-balancer-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check eslint.config.mjs vitest.config.ts playwright.config.ts 'features/**/*.{ts,tsx}' 'lib/api/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:contracts": "node scripts/verify-contracts.mjs",
    "test:links": "node scripts/verify-export-links.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:contracts",
    "verify": "npm run check && npm run build && npm run test:links"
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-query": "5.87.1",
    "lucide-react": "1.25.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.21",
    "sharp": "0.35.3"
  }
}
